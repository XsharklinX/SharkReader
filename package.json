{
  "name": "sharkreader",
  "version": "2.7.1",
  "description": "Lector de EPUB y PDF con IA, pestañas, Pomodoro y vocabulario",
  "main": "main.js",
  "author": "David Bonilla",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "start": "node scripts/dev.cjs",
    "build:renderer": "vite build",
    "build": "pnpm build:renderer && electron-builder --win nsis portable",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.sharkreader.app",
    "productName": "SharkReader",
    "copyright": "Copyright © 2025 SharkReader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist-renderer/**",
      "icon_build.ico",
      "node_modules/**",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/.cache/**"
    ],
    "win": {
      "icon": "icon_build.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon_build.ico",
      "uninstallerIcon": "icon_build.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SharkReader",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "SharkReader-Portable-${version}.exe"
    }
  },
  "keywords": [],
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.10",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "lie": "~3.3.0",
    "pako": "~1.0.2",
    "pdfjs-dist": "^5.6.205",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "readable-stream": "~2.3.6",
    "setimmediate": "^1.0.5"
  }
}